# MyProfile для предпринимателей

SEPARATOR = '------------------------------------------'

# personal info
name = ''
age = 0
phone = ''
email = ''
postal_code = ''
address = ''
additional_information = ''

# entrepreneur info
ogrnip = 0
inn = 0
bank_account = 0
bank_name = ''
bank_identification_code = 0
correspondent_account = 0


def print_personal_information(name_parameter, age_parameter, phone_parameter,
                                email_parameter, postal_code_parameter,
                                address_parameter, additional_information_parameter):
    print(SEPARATOR)
    print('Имя:    ', name_parameter)

    if 11 <= age_parameter % 100 <= 19:
        years_parameter = 'лет'
    elif age_parameter % 10 == 1:
        years_parameter = 'год'
    elif 2 <= age_parameter % 10 <= 4:
        years_parameter = 'года'
    else:
        years_parameter = 'лет'

    print('Возраст:', age_parameter, years_parameter)
    print('Телефон:', phone_parameter)
    print('E-mail: ', email_parameter)
    print('Индекс: ', postal_code_parameter)
    print('Адрес:  ', address_parameter)

    if additional_information_parameter:
        print('')
        print('Дополнительная информация:')
        print(additional_information_parameter)


def print_entrepreneur_information(ogrnip_parameter, inn_parameter,
                                    bank_account_parameter, bank_name_parameter,
                                    bank_identification_code_parameter,
                                    correspondent_account_parameter):
    print('')
    print('Информация о предпринимателе')
    print('ОГРНИП:', ogrnip_parameter)
    print('ИНН:   ', inn_parameter)
    print('Банковские реквизиты')
    print('Р/с:', bank_account_parameter)
    print('Банк:', bank_name_parameter)
    print('БИК:', bank_identification_code_parameter)
    print('К/с:', correspondent_account_parameter)


print('Приложение MyProfile для предпринимателей')
print('Сохраняй информацию о себе и выводи ее в разных форматах')

while True:
    # main menu
    print(SEPARATOR)
    print('ГЛАВНОЕ МЕНЮ')
    print('1 - Ввести или обновить информацию')
    print('2 - Вывести информацию')
    print('0 - Завершить работу')

    option = int(input('Введите номер пункта меню: '))
    if option == 0:
        break

    if option == 1:
        # submenu 1: edit info
        while True:
            print(SEPARATOR)
            print('ВВЕСТИ ИЛИ ОБНОВИТЬ ИНФОРМАЦИЮ')
            print('1 - Личная информация')
            print('2 - Информация о предпринимателе')
            print('0 - Назад')

            option2 = int(input('Введите номер пункта меню: '))
            if option2 == 0:
                break

            if option2 == 1:
                # input personal info
                name = input('Введите имя: ')

                while True:
                    # validate user age
                    age = int(input('Введите возраст: '))
                    if age >= 0:
                        break
                    print('Возраст не может быть отрицательным')

                entered_phone = input('Введите номер телефона (+7ХХХХХХХХХХ): ')
                phone = ''
                for character in entered_phone:
                    if character == '+' or ('0' <= character <= '9'):
                        phone += character

                email = input('Введите адрес электронной почты: ')

                entered_postal_code = input('Введите почтовый индекс: ')
                postal_code = ''
                for character in entered_postal_code:
                    if '0' <= character <= '9':
                        postal_code += character

                address = input('Введите почтовый адрес (без индекса): ')
                additional_information = input('Введите дополнительную информацию:\n')

            elif option2 == 2:
                # input entrepreneur info
                while True:
                    # validate ogrnip
                    ogrnip = int(input('Введите ОГРНИП: '))
                    if len(str(ogrnip)) == 15:
                        break
                    print('ОГРНИП должен содержать 15 цифр')

                inn = int(input('Введите ИНН: '))

                while True:
                    # validate bank account
                    bank_account = int(input('Введите расчетный счет: '))
                    if len(str(bank_account)) == 20:
                        break
                    print('Расчетный счет должен содержать 20 цифр')

                bank_name = input('Введите название банка: ')
                bank_identification_code = int(input('Введите БИК: '))
                correspondent_account = int(input('Введите корреспондентский счет: '))

            else:
                print('Введите корректный пункт меню')

    elif option == 2:
        # submenu 2: print info
        while True:
            print(SEPARATOR)
            print('ВЫВЕСТИ ИНФОРМАЦИЮ')
            print('1 - Личная информация')
            print('2 - Вся информация')
            print('0 - Назад')

            option2 = int(input('Введите номер пункта меню: '))
            if option2 == 0:
                break

            if option2 == 1:
                print_personal_information(name, age, phone, email,
                                            postal_code, address,
                                            additional_information)

            elif option2 == 2:
                print_personal_information(name, age, phone, email,
                                            postal_code, address,
                                            additional_information)
                print_entrepreneur_information(ogrnip, inn, bank_account,
                                                bank_name,
                                                bank_identification_code,
                                                correspondent_account)

            else:
                print('Введите корректный пункт меню')

    else:
        print('Введите корректный пункт меню')